{
  "realm": "bank-realm",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Regular bank user" },
      { "name": "ACCOUNTS_READ", "description": "Permission to read accounts" },
      { "name": "ACCOUNTS_WRITE", "description": "Permission to update accounts" },
      { "name": "CASH_WRITE", "description": "Permission to perform cash operations" },
      { "name": "TRANSFER_WRITE", "description": "Permission to perform transfers" },
      { "name": "SERVICE", "description": "Generic service role for microservices" },
      { "name": "ACCOUNTS_INTERNAL", "description": "Permission to call internal accounts API" },
      { "name": "NOTIFICATIONS_WRITE", "description": "Permission to create notifications" }
    ]
  },
  "clients": [
    {
      "clientId": "front-ui",
      "name": "Front UI",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__FRONT_UI_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8085/login/oauth2/code/*"],
      "baseUrl": "http://localhost:8085",
      "webOrigins": ["http://localhost:8085"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8085/"
      },
      "defaultClientScopes": ["web-origins", "role_list", "profile", "email", "roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "cash-service",
      "name": "Cash Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__CASH_SERVICE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "transfer-service",
      "name": "Transfer Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__TRANSFER_SERVICE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "accounts-service",
      "name": "Accounts Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__ACCOUNTS_SERVICE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "notifications-service",
      "name": "Notifications Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__NOTIFICATIONS_SERVICE_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "exchange-generator",
      "name": "Exchange Generator",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__EXCHANGE_GENERATOR_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "ivan",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Иван",
      "lastName": "Иванов",
      "email": "ivan@example.local",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "ivan", "temporary": false }],
      "realmRoles": ["USER", "ACCOUNTS_READ", "ACCOUNTS_WRITE", "CASH_WRITE", "TRANSFER_WRITE"]
    },
    {
      "username": "petr",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Пётр",
      "lastName": "Петров",
      "email": "petr@example.local",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "petr", "temporary": false }],
      "realmRoles": ["USER", "ACCOUNTS_READ", "ACCOUNTS_WRITE", "CASH_WRITE", "TRANSFER_WRITE"]
    },
    {
      "username": "anna",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Анна",
      "lastName": "Сидорова",
      "email": "anna@example.local",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "anna", "temporary": false }],
      "realmRoles": ["USER", "ACCOUNTS_READ", "ACCOUNTS_WRITE", "CASH_WRITE", "TRANSFER_WRITE"]
    },
    {
      "username": "service-account-cash-service",
      "enabled": true,
      "serviceAccountClientId": "cash-service",
      "realmRoles": ["SERVICE", "ACCOUNTS_INTERNAL", "NOTIFICATIONS_WRITE"]
    },
    {
      "username": "service-account-transfer-service",
      "enabled": true,
      "serviceAccountClientId": "transfer-service",
      "realmRoles": ["SERVICE", "ACCOUNTS_INTERNAL", "NOTIFICATIONS_WRITE"]
    },
    {
      "username": "service-account-accounts-service",
      "enabled": true,
      "serviceAccountClientId": "accounts-service",
      "realmRoles": ["SERVICE", "NOTIFICATIONS_WRITE"]
    },
    {
      "username": "service-account-notifications-service",
      "enabled": true,
      "serviceAccountClientId": "notifications-service",
      "realmRoles": ["SERVICE", "NOTIFICATIONS_WRITE"]
    },
    {
      "username": "service-account-exchange-generator",
      "enabled": true,
      "serviceAccountClientId": "exchange-generator",
      "realmRoles": ["SERVICE"]
    }
  ]
}
